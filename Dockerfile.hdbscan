FROM python:3.9-slim-buster

# Install system dependencies needed for compilation
RUN apt-get update && apt-get install -y \
    build-essential \
    libopenblas-dev \
    gcc \
    gfortran \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create a Python virtual environment and activate it
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install base Python packages with specific versions
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
        numpy==1.24.4 \
        scipy==1.11.1 \
        cython==0.29.36 \
        scikit-learn==1.3.0

# Install hdbscan with the compatible version
RUN pip install --no-cache-dir hdbscan==0.8.33

# Create a test script directly in the Dockerfile
RUN echo "import hdbscan; print('HDBSCAN installation successful')" > test.py

# Test the installation
RUN python test.py

CMD ["tail", "-f", "/dev/null"]